SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
GEMINI_API_KEY=your-server-only-key
AZURE_SPEECH_KEY=your-server-only-key
AZURE_SPEECH_REGION=your-region
AZURE_SPEECH_VOICE=my-MM-NilarNeural
REVENUECAT_API_KEY=replace-with-server-only-secret-key
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_WEBHOOK_AUTH=replace-with-a-long-random-webhook-secret
REVENUECAT_CACHE_SECONDS=300
REVENUECAT_CACHE_GRACE_SECONDS=86400
FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/service-account.json
# Enable only in one dedicated worker until database fencing is verified.
SCHEDULER_ENABLED=false
# Durable manual generation queue. Enable only in a process with provider keys.
GENERATION_WORKER_ENABLED=false
# Enable only after the reviewed staging preference migration is applied.
AUTOMATIC_BRIEFING_PREFERENCES_ENABLED=false
# Requires notification outbox migration and Firebase credentials.
PUSH_DELIVERY_ENABLED=false
# Independent opt-in: reviewed RSS feeds only, no generation. Use one worker process.
NEWS_INGESTION_ENABLED=false
NEWS_INGESTION_INTERVAL_MINUTES=30
# Allows an entitled Generate request to refresh reviewed feeds once when no recent stories exist.
ON_DEMAND_NEWS_REFRESH_ENABLED=false
# Comma-separated verified Supabase user UUIDs; empty disables ingestion access.
INGESTION_OPERATOR_IDS=
# Short-lived authenticated staging operator JWT; required only for an approved RSS import.
RSS_IMPORT_ACCESS_TOKEN=
# Set true only after the dedicated staging INSERT RLS policy is reviewed and verified.
RSS_IMPORT_RLS_POLICY_VERIFIED=false
SUPABASE_ACCESS_TOKEN=your-scoped-management-token
# Separate migration credential; runtime Supabase clients do not read these tokens.
SUPABASE_ACCESS_TOKEN_STAGING=your-staging-only-management-token

# Browser origins only; native mobile requests do not require CORS. Keep empty to deny browser origins.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Enable requests only after the deletion worker is deployed and monitored.
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_WORKER_ENABLED=false
# Service-only cleanup of terminal operational records.
RETENTION_WORKER_ENABLED=false
GENERATION_REQUEST_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30
BILLING_EVENT_RETENTION_DAYS=90
DELETION_JOB_RETENTION_DAYS=30

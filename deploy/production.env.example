SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-in-secret-manager
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
GEMINI_API_KEY=replace-in-secret-manager
AZURE_SPEECH_KEY=replace-in-secret-manager
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=my-MM-NilarNeural
REVENUECAT_API_KEY=replace-in-secret-manager
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_WEBHOOK_AUTH=replace-with-a-long-random-webhook-secret
REVENUECAT_CACHE_SECONDS=300
REVENUECAT_CACHE_GRACE_SECONDS=86400
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
CORS_ALLOWED_ORIGINS=
AUTOMATIC_BRIEFING_PREFERENCES_ENABLED=true
BRIEFING_GENERATION_ENABLED=true
GENERATION_WORKER_ENABLED=true
SCHEDULER_ENABLED=true
NEWS_INGESTION_ENABLED=true
PUSH_DELIVERY_ENABLED=true
RETENTION_WORKER_ENABLED=true
INGESTION_OPERATOR_IDS=
NEWS_INGESTION_INTERVAL_MINUTES=30
ON_DEMAND_NEWS_REFRESH_ENABLED=false
ACCOUNT_DELETION_ENABLED=true
ACCOUNT_DELETION_WORKER_ENABLED=true
GENERATION_REQUEST_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30
BILLING_EVENT_RETENTION_DAYS=90
DELETION_JOB_RETENTION_DAYS=30
FORWARDED_ALLOW_IPS=127.0.0.1
